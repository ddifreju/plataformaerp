# Ambiente de STAGING (Fase 4, bloco B - tarefa 29).
# Sobe com `make staging-subir`, a partir da raiz do projeto.
#
# Nenhuma senha real aqui: copie para infra/.env.staging (NAO versionado,
# ver .gitignore) e preencha com valores de teste antes do primeiro uso.
# Este arquivo existe so para provar, numa maquina sem VPS e sem dominio,
# que o cookie de sessao sai "Secure" de verdade atras de TLS (decisao
# 0032) - NAO e o ambiente de producao.

# --- Banco (dono do schema, usado so pelo Postgres do container) --------
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma_dono
POSTGRES_PASSWORD=troque-por-uma-senha-de-teste

# --- Credenciais que o BACKEND usa para conectar -------------------------
# Papel "app_aplicacao" (V004): sem DDL, sem BYPASSRLS - nunca aponte
# isto para o mesmo usuario de POSTGRES_USER acima. Depois de subir,
# defina a senha deste papel no banco de staging (mesmo passo do
# "make definir-senha-app" do ambiente de dev, contra este outro banco -
# ver docs/checklist-deploy.md).
SPRING_DATASOURCE_USERNAME=app_aplicacao
SPRING_DATASOURCE_PASSWORD=troque-por-outra-senha-de-teste

# --- Chave HMAC de documento (docs/PENDENCIAS.md) -------------------------
# HMAC-SHA256 usado para gerar cliente.documento_hash a partir do
# CPF/CNPJ. Obrigatoria fora do perfil "dev" - o backend recusa subir
# sem ela (tarefa 30). Gere uma chave aleatoria longa; trocar depois
# invalida todo hash ja gravado.
APP_DOCUMENTO_HMAC_CHAVE=troque-por-uma-chave-aleatoria-longa-de-teste

# --- CORS (decisao 0025/0032) ---------------------------------------------
# Deixe VAZIO. Frontend e backend ficam atras do Caddy, na mesma origem -
# nao existe requisicao cross-origin para autorizar. So preencha isto
# para depurar um caso excepcional, e NUNCA com "*" (a aplicacao recusa
# subir se detectar isso).
APP_CORS_ORIGENS=
