# Copie este arquivo para infra/.env e ajuste os valores.
#
#     cp infra/.env.exemplo infra/.env
#
# infra/.env está no .gitignore e NUNCA deve ser commitado.
# Estes valores são de desenvolvimento local. Em produção, as mesmas
# variáveis vêm do gerenciador de segredos do host, nunca de arquivo.

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
# Troque por qualquer coisa local. Não precisa ser forte em dev,
# mas precisa ser DIFERENTE da senha de produção.
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_PORT=5432

# --- Papel de aplicação ---------------------------------------------------
# Papel sem BYPASSRLS usado pelo backend. Ver V004__papel_aplicacao.sql.
APP_DB_USER=app_aplicacao
APP_DB_PASSWORD=troque_esta_senha_local_tambem

# --- Backend --------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Ferramentas opcionais ------------------------------------------------
ADMINER_PORT=8081
