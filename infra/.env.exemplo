# Copie este arquivo para infra/.env e ajuste os valores.
#
#     cp infra/.env.exemplo infra/.env
#
# infra/.env está no .gitignore e NUNCA deve ser commitado.
# Estes valores são de desenvolvimento local. Em produção, as mesmas
# variáveis vêm do gerenciador de segredos do host, nunca de arquivo.

# --- Postgres (container) -------------------------------------------------
# Este é o usuário DONO do banco. Ele tem DDL. A aplicação NÃO usa este.
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
# Troque por qualquer coisa local. Não precisa ser forte em dev,
# mas precisa ser DIFERENTE da senha de produção.
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_PORT=5432

# --- Backend em execução --------------------------------------------------
# A aplicação conecta como app_aplicacao: papel SEM privilégio de DDL e SEM
# BYPASSRLS (ver V004__papel_aplicacao.sql). Isso é deliberado — é o que
# impede que o Row Level Security seja decorativo. Se você apontar a
# aplicação para o usuário dono, o isolamento continua funcionando (usamos
# FORCE RLS), mas você perde a segunda rede de proteção. Não faça isso.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/plataforma
SPRING_DATASOURCE_USERNAME=app_aplicacao
SPRING_DATASOURCE_PASSWORD=troque_esta_senha_do_app

BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Migrations (`make migrate`) ------------------------------------------
# O Flyway roda com usuário DIFERENTE do da aplicação, porque migration
# precisa de DDL e a aplicação não pode ter DDL. Aqui usamos o dono do banco.
FLYWAY_URL=jdbc:postgresql://localhost:5432/plataforma
FLYWAY_USUARIO=plataforma
FLYWAY_SENHA=troque_esta_senha_local

# --- Senha do papel de aplicação ------------------------------------------
# A V004 cria app_aplicacao SEM senha, de propósito: segredo não entra em
# migration versionada. Depois do primeiro `make migrate`, rode:
#
#     make definir-senha-app
#
# Ele usa APP_DB_PASSWORD abaixo, que precisa ser IGUAL a
# SPRING_DATASOURCE_PASSWORD acima.
APP_DB_USER=app_aplicacao
APP_DB_PASSWORD=troque_esta_senha_do_app

# --- Ferramentas opcionais ------------------------------------------------
ADMINER_PORT=8081
